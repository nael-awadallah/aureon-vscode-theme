{
  "name": "aureon-theme",
  "displayName": "Aureon Theme",
  "description": "A refined, modern theme family with warm gold accents — elegant, readable, and easy on the eyes.",
  "publisher": "nael-awadallah",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "gold",
    "warm",
    "elegant",
    "color-theme"
  ],
  "galleryBanner": {
    "color": "#141311",
    "theme": "dark"
  },
  "files": [
    "themes/*.json",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx src/build.ts",
    "dev": "tsx watch src/build.ts",
    "check": "tsx src/check.ts",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --allow-missing-repository",
    "test": "tsx --test test/textmate.test.ts",
    "scopes": "tsx test/scopes.ts",
    "test:vscode": "tsx test/vscode/run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "shiki": "^3.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "contributes": {
    "themes": [
      {
        "label": "Aureon Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/aureon-dark.json"
      },
      {
        "label": "Aureon Dark Vivid",
        "uiTheme": "vs-dark",
        "path": "./themes/aureon-dark-vivid.json"
      },
      {
        "label": "Aureon Dusk",
        "uiTheme": "vs-dark",
        "path": "./themes/aureon-dusk.json"
      },
      {
        "label": "Aureon Dusk Vivid",
        "uiTheme": "vs-dark",
        "path": "./themes/aureon-dusk-vivid.json"
      },
      {
        "label": "Aureon Light",
        "uiTheme": "vs",
        "path": "./themes/aureon-light.json"
      },
      {
        "label": "Aureon Light Vivid",
        "uiTheme": "vs",
        "path": "./themes/aureon-light-vivid.json"
      }
    ]
  }
}
