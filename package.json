{
  "name": "aureon-theme",
  "displayName": "Aureon Theme",
  "description": "A refined theme family for focused development: Dark, Dusk and Light, with semantic highlighting and a fully themed UI.",
  "publisher": "nael-awadallah",
  "version": "0.2.0",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nael-awadallah/aureon-vscode-theme.git"
  },
  "homepage": "https://github.com/nael-awadallah/aureon-vscode-theme#readme",
  "bugs": {
    "url": "https://github.com/nael-awadallah/aureon-vscode-theme/issues"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "dark",
    "light",
    "gold",
    "warm",
    "elegant",
    "semantic",
    "semantic-highlighting",
    "dusk",
    "teal"
  ],
  "galleryBanner": {
    "color": "#141311",
    "theme": "dark"
  },
  "files": [
    "themes/*.json",
    "images/icon.png",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx src/build.ts",
    "dev": "tsx watch src/build.ts",
    "check": "tsx src/check.ts",
    "typecheck": "tsc --noEmit",
    "package": "vsce package",
    "test": "tsx --test test/textmate.test.ts",
    "scopes": "tsx test/scopes.ts",
    "test:vscode": "tsx test/vscode/run.ts",
    "icon": "tsx tools/icon.ts",
    "screenshots": "tsx tools/screenshots/run.ts",
    "hero": "tsx tools/hero.ts",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "site": "tsx tools/site/build.ts",
    "compare": "tsx tools/screenshots/run.ts --compare"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "ovsx": "^1.2.0",
    "sharp": "^0.35.5",
    "shiki": "^3.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "contributes": {
    "themes": [
      {
        "label": "Aureon Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/aureon-dark.json"
      },
      {
        "label": "Aureon Dark Vivid",
        "uiTheme": "vs-dark",
        "path": "./themes/aureon-dark-vivid.json"
      },
      {
        "label": "Aureon Dark No Italics",
        "uiTheme": "vs-dark",
        "path": "./themes/aureon-dark-no-italics.json"
      },
      {
        "label": "Aureon Dusk",
        "uiTheme": "vs-dark",
        "path": "./themes/aureon-dusk.json"
      },
      {
        "label": "Aureon Dusk Vivid",
        "uiTheme": "vs-dark",
        "path": "./themes/aureon-dusk-vivid.json"
      },
      {
        "label": "Aureon Dusk No Italics",
        "uiTheme": "vs-dark",
        "path": "./themes/aureon-dusk-no-italics.json"
      },
      {
        "label": "Aureon Light",
        "uiTheme": "vs",
        "path": "./themes/aureon-light.json"
      },
      {
        "label": "Aureon Light Vivid",
        "uiTheme": "vs",
        "path": "./themes/aureon-light-vivid.json"
      },
      {
        "label": "Aureon Light No Italics",
        "uiTheme": "vs",
        "path": "./themes/aureon-light-no-italics.json"
      }
    ]
  }
}
